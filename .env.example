# ============================================================
# AIONOS Customer-Facing Resolution Agent Environment Config
# ============================================================

# Backend Port
SERVER_PORT=8080

# Spring Boot Active Profiles
SPRING_PROFILES_ACTIVE=default

# Database Configuration (H2 Default)
SPRING_DATASOURCE_URL=jdbc:h2:mem:aionosdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=password
SPRING_H2_CONSOLE_ENABLED=true

# Optional MySQL Database Configuration (Uncomment to switch from H2)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aionos_agent?createDatabaseIfNotExist=true&useSSL=false
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=rootpassword
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# AI / LLM Configuration (Optional - Demo Mode is enabled by default)
# The application works 100% locally in DEMO MODE without any API key.
AIONOS_AI_ENABLED=false
AIONOS_AI_PROVIDER=demo
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api